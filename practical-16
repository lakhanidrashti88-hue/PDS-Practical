import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import norm, expon

# --------------------------------
# 1. Normal Distribution
# --------------------------------

mean = 50
std = 10

x_normal = np.linspace(10, 90, 1000)
normal_pdf = norm.pdf(x_normal, mean, std)

# --------------------------------
# 2. Exponential Distribution
# --------------------------------

scale = 5

x_exponential = np.linspace(0, 25, 1000)
exponential_pdf = expon.pdf(x_exponential, scale=scale)

# --------------------------------
# 3. Central Limit Theorem
# --------------------------------

# Generate an exponential population
population = np.random.exponential(scale=5, size=100000)

# Take samples and calculate their means
sample_means = []

for i in range(1000):
    sample = np.random.choice(population, size=30)
    sample_means.append(np.mean(sample))

sample_means = np.array(sample_means)

# --------------------------------
# Visualization
# --------------------------------

plt.figure(figsize=(15, 5))

# Normal Distribution
plt.subplot(1, 3, 1)
plt.plot(x_normal, normal_pdf)
plt.title("Normal Distribution")
plt.xlabel("Value")
plt.ylabel("Probability Density")

# Exponential Distribution
plt.subplot(1, 3, 2)
plt.plot(x_exponential, exponential_pdf)
plt.title("Exponential Distribution")
plt.xlabel("Value")
plt.ylabel("Probability Density")

# Central Limit Theorem
plt.subplot(1, 3, 3)
plt.hist(sample_means, bins=30, density=True)
plt.title("Central Limit Theorem")
plt.xlabel("Sample Means")
plt.ylabel("Frequency")

plt.tight_layout()
plt.show()

# --------------------------------
# Analysis
# --------------------------------

print("Normal Distribution")
print("Mean =", mean)
print("Standard Deviation =", std)

print("\nExponential Distribution")
print("Mean =", scale)

print("\nCentral Limit Theorem")
print("Number of samples =", 1000)
print("Sample size =", 30)
print("Mean of sample means =", round(np.mean(sample_means), 2))
print("Standard deviation of sample means =", round(np.std(sample_means), 2))
