# Variables and Data Types
a = 10
b = 5
price = 25.5
name = "Drashti"
is_student = True

print("Variables and Data Types")
print("Integer:", a)
print("Float:", price)
print("String:", name)
print("Boolean:", is_student)

# Arithmetic Operators
print("\nArithmetic Operators")
print("Addition:", a + b)
print("Subtraction:", a - b)
print("Multiplication:", a * b)
print("Division:", a / b)
print("Floor Division:", a // b)
print("Modulus:", a % b)
print("Exponent:", a ** b)

# Assignment Operators
print("\nAssignment Operators")
x = 10
x += 5
print("x += 5:", x)
x -= 3
print("x -= 3:", x)
x *= 2
print("x *= 2:", x)
x /= 4
print("x /= 4:", x)
x //= 2
print("x //= 2:", x)
x %= 3
print("x %= 3:", x)

# Comparison Operators
print("\nComparison Operators")
p = 10
q = 5
print("p == q:", p == q)
print("p != q:", p != q)
print("p > q:", p > q)
print("p < q:", p < q)
print("p >= q:", p >= q)
print("p <= q:", p <= q)

# Logical Operators
print("\nLogical Operators")
print("AND:", p > 5 and q < 10)
print("OR:", p > 5 or q > 10)
print("NOT:", not(p > 5))

# Membership Operators
print("\nMembership Operators")
text = "Python"
print("'P' in text:", 'P' in text)
print("'z' in text:", 'z' in text)
print("'P' not in text:", 'P' not in text)

# Identity Operators
print("\nIdentity Operators")
list1 = [1, 2, 3]
list2 = list1
list3 = [1, 2, 3]

print("list1 is list2:", list1 is list2)
print("list1 is list3:", list1 is list3)
print("list1 is not list3:", list1 is not list3)

# Bitwise Operators
print("\nBitwise Operators")
m = 10
n = 5

print("Bitwise AND:", m & n)
print("Bitwise OR:", m | n)
print("Bitwise XOR:", m ^ n)
print("Bitwise NOT:", ~m)
print("Left Shift:", m << 1)
print("Right Shift:", m >> 1)
