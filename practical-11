import pandas as pd

# 1. Create a Series
print("----- SERIES -----")

marks = pd.Series([80, 75, 90, 85, 70])

print("Marks Series:")
print(marks)


# 2. Create a DataFrame
print("\n----- DATAFRAME -----")

data = {
    "Name": ["Drashti", "Rahul", "Priya", "Amit", "Neha"],
    "Age": [19, 20, 19, 21, 20],
    "Course": ["CE", "CE", "IT", "IT", "CE"],
    "Marks": [85, 75, 90, 80, 70]
}

df = pd.DataFrame(data)

print("Student DataFrame:")
print(df)


# 3. Data Selection
print("\n----- DATA SELECTION -----")

print("Name column:")
print(df["Name"])

print("\nName and Marks:")
print(df[["Name", "Marks"]])

print("\nFirst row:")
print(df.iloc[0])

print("\nSecond and third rows:")
print(df.iloc[1:3])


# 4. Filtering
print("\n----- FILTERING -----")

print("Students with marks greater than 80:")
print(df[df["Marks"] > 80])

print("\nStudents belonging to CE:")
print(df[df["Course"] == "CE"])


# 5. Grouping
print("\n----- GROUPING -----")

print("Students grouped by Course:")
print(df.groupby("Course")["Marks"].mean())


# 6. Aggregation
print("\n----- AGGREGATION -----")

print("Average Marks:", df["Marks"].mean())
print("Maximum Marks:", df["Marks"].max())
print("Minimum Marks:", df["Marks"].min())
print("Total Marks:", df["Marks"].sum())
print("Number of Students:", df["Name"].count())


# Multiple Aggregations
print("\nMultiple Aggregations:")
print(df.groupby("Course")["Marks"].agg(["mean", "max", "min", "sum"]))
