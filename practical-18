import pandas as pd

# Create a sample dataset
data = {
    "Name": ["Amit", "Riya", "Rahul", "Neha", "Amit", "Karan", "Priya"],
    "Age": [20, 21, None, 22, 20, 100, 23],
    "Marks": [85, 90, 78, None, 85, 95, 150]
}

df = pd.DataFrame(data)

print("Original Dataset:")
print(df)

# -----------------------------------
# 1. Detect Missing Values
# -----------------------------------

print("\nMissing Values:")
print(df.isnull().sum())

# Handle missing values using mean
df["Age"] = df["Age"].fillna(df["Age"].mean())
df["Marks"] = df["Marks"].fillna(df["Marks"].mean())

# -----------------------------------
# 2. Remove Duplicate Records
# -----------------------------------

df = df.drop_duplicates()

print("\nAfter Removing Duplicates:")
print(df)

# -----------------------------------
# 3. Detect and Treat Outliers
#    Using IQR Method
# -----------------------------------

Q1 = df[["Age", "Marks"]].quantile(0.25)
Q3 = df[["Age", "Marks"]].quantile(0.75)

IQR = Q3 - Q1

lower_limit = Q1 - 1.5 * IQR
upper_limit = Q3 + 1.5 * IQR

# Replace outliers with median
for column in ["Age", "Marks"]:
    median = df[column].median()

    df[column] = df[column].apply(
        lambda x: median if x < lower_limit[column] or x > upper_limit[column] else x
    )

print("\nCleaned Dataset:")
print(df)
