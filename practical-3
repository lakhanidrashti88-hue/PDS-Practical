# Program to check positive number

num = 10

if num > 0:
    print("Number is positive")
# Program to check even or odd

num = 7

if num % 2 == 0:
    print("Number is even")
else:
    print("Number is odd")

    # Program to display grade

marks = 75

if marks >= 90:
    print("Grade A+")
elif marks >= 80:
    print("Grade A")
elif marks >= 70:
    print("Grade B")
elif marks >= 60:
    print("Grade C")
else:
    print("Grade D")

    # Print numbers from 1 to 5

i = 1

while i <= 5:
    print(i)
    i += 1

    # Print numbers from 1 to 5

for i in range(1, 6):
    print(i)

    # Program to print a pattern

for i in range(1, 4):
    for j in range(1, 4):
        print("*", end=" ")
    print()

    # Program to demonstrate break

for i in range(1, 10):
    if i == 5:
        break
    print(i)

    # Program to demonstrate continue

for i in range(1, 6):
    if i == 3:
        continue
    print(i)

    # Program to demonstrate pass

for i in range(1, 6):
    if i == 3:
        pass
    print(i)

    
